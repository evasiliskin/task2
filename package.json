{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "cross-env NODE_ENV=development ng",
    "start": "cross-env NODE_ENV=development ng serve",
    "build": "cross-env NODE_ENV=production ng build",
    "watch": "cross-env NODE_ENV=development ng build --watch --configuration development",
    "test": "cross-env NODE_ENV=test ng test",
    "test:ci": "cross-env NODE_ENV=test ng test --watch=false",
    "lint": "cross-env NODE_ENV=development ng lint",
    "format": "cross-env NODE_ENV=development prettier --write \"src/**/*.{ts,html,scss}\" \"*.md\"",
    "format:check": "cross-env NODE_ENV=development prettier --check \"src/**/*.{ts,html,scss}\" \"*.md\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test:ci && pnpm run build",
    "e2e": "playwright test",
    "prepare": "cross-env NODE_ENV=development husky"
  },
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@ngrx/effects": "^22.0.0-rc.0",
    "@ngrx/entity": "^22.0.0-rc.0",
    "@ngrx/store": "^22.0.0-rc.0",
    "@ngrx/store-devtools": "^22.0.0-rc.0",
    "ng-zorro-antd": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "angular-eslint": "22.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
